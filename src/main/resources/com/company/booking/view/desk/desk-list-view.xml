<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://deskListView.title"
      focusComponent="desksDataGrid">
    <data>
        <collection id="desksDc"
                    class="com.company.booking.entity.Desk">
            <fetchPlan extends="_base">
                <property name="floor" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="desksDl" readOnly="true">
                <query>
                    <![CDATA[select e from Desk e order by e.floor.building.name, e.floor.number, e.code]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="desksDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <endSlot>
                <simplePagination id="pagination" dataLoader="desksDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="desksDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="desksDc"
                  columnReorderingAllowed="true">
            <columns resizable="true">
                <column property="floor"/>
                <column property="code"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
